# All variables are optional. Run `myfitnesspal-mcp auth` for the guided setup instead.

# MyFitnessPal session cookie: either the full Cookie header from a logged-in
# browser request, or just the value of __Secure-next-auth.session-token.
# MFP_COOKIE=

# Your MyFitnessPal username (not email). Only needed if MFP's profile endpoint
# fails for your account (the server will tell you).
# MFP_USERNAME=

# Browser fingerprint for Cloudflare. Try chrome124 etc. if you get 403s.
# MFP_IMPERSONATE=chrome

# Per-request MyFitnessPal HTTP timeout in seconds (default 30; must be > 0 and
# no more than 300).
# MFP_REQUEST_TIMEOUT=30

# How many days back to gap-fill the local cache (default 30).
# MFP_SYNC_DAYS=30

# Where to keep the local SQLite cache (default: platform data dir).
# MFP_MCP_DATA_DIR=

# Optional explicit SQLite database file. Useful for a persistent Docker mount,
# for example /data/mfp.sqlite3. Takes precedence over MFP_MCP_DATA_DIR.
# MFP_DATABASE_PATH=

# Freshness policy. Defaults preserve live today reads, 24-hour recent-history
# reconciliation, and immutable cached data outside the 30-day mutable window.
# MFP_TODAY_TTL_SECONDS=0
# MFP_YESTERDAY_TTL_HOURS=24
# MFP_RECENT_TTL_HOURS=24
# MFP_MUTABLE_HISTORY_DAYS=30

# Conservative pacing for all MyFitnessPal HTTP requests. Set requests per
# minute to 0 only when deliberately disabling rate limiting.
# MFP_RATE_LIMIT_REQUESTS_PER_MINUTE=6
# MFP_RATE_LIMIT_BURST=1
# MFP_RATE_LIMIT_JITTER_SECONDS=2

# Bounded retry behavior for transient synchronization failures.
# MFP_RETRY_ATTEMPTS=2
# MFP_RETRY_BACKOFF_SECONDS=2

# DEBUG, INFO, WARNING, ERROR, or CRITICAL.
# MFP_LOG_LEVEL=WARNING
